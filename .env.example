# ============================================================
# Variáveis de Ambiente — Portal Cerrado
# ============================================================
# Copie este arquivo para .env e preencha os valores
# ============================================================

# ============================================================
# LLM
# ============================================================
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ============================================================
# DATABASE (PostgreSQL via Docker)
# ============================================================
DATABASE_URL=postgresql://portal_user:CHANGE_ME_LOCAL_PASSWORD@postgres:5432/portal_cerrado
POSTGRES_USER=portal_user
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_PASSWORD
POSTGRES_DB=portal_cerrado

# ============================================================
# REDIS
# ============================================================
REDIS_URL=redis://redis:6379/0

# ============================================================
# CELERY
# ============================================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
# Quando Celery Beat está ativo (docker-compose), desativa o scheduler local duplicado
CELERY_SCHEDULER=0

# ============================================================
# AGENDADOR LOCAL (sem Redis/Celery)
# Roda o pipeline (scan->classify->rewrite->publish->export) no
# próprio processo da API a cada intervalo. Desative (0) quando o
# Celery beat estiver gerenciando o agendamento.
# ============================================================
ENABLE_LOCAL_SCHEDULER=1
LOCAL_SCHEDULER_INTERVAL=1800
# Em produção com docker-compose, portal_cerrado tem CELERY_SCHEDULER=1 e o scheduler local auto-desativa

# ============================================================
# SITE
# ============================================================
SITE_URL=https://www.portalcerrado.com.br
SITE_NAME=Portal Cerrado
DEFAULT_LOCALE=pt-BR
TIMEZONE=America/Campo_Grande

# ============================================================
# SCRAPING
# ============================================================
USER_AGENT=PortalCerrado/1.0 (News Aggregator; +https://portalcerrado.com.br)
RESPECT_ROBOTS_TXT=true
ROBOTS_TXT_CACHE_HOURS=24
RATE_LIMIT_DEFAULT=10
ARCHIVE_DAYS_AFTER_PUBLISH=30

# ============================================================
# SEGURANÇA / CORS / PUBLISH
# ============================================================
# Chave para POST /api/publish (header X-API-Key). Gere com: openssl rand -hex 32
PUBLISH_API_KEY=coloque_uma_chave_longa_aqui
PUBLISH_API_KEY_PREVIOUS=
# Se não setado, em production o /api/publish retorna 503 (fail-closed)
# Em dev, sem chave, o publish é permitido com warning

# CORS: lista explícita (sem wildcard + credentials). Separe por vírgula.
CORS_ALLOWED_ORIGINS=http://100.95.111.24:3000,http://localhost:3000

# Lei 9.610/98 Art. 46/47: similaridade máxima permitida entre reescrita e original (0.35 = 35%)
SIMILARITY_THRESHOLD=0.35

# Deduplicação persistida via Redis (TTL em segundos, default 7 dias)
DEDUP_TTL_SECONDS=604800

# ============================================================
# EMAIL (opcional)
# ============================================================
ADMIN_EMAIL=admin@portalcerrado.com.br
PRIVACY_EMAIL=privacidade@portalcerrado.com.br

# ============================================================
# MONITORING (opcional)
# ============================================================
SENTRY_DSN=

# Provider alternativo, se selecionado em LLM_PROVIDER
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3-32b

# ============================================================
# FRONTEND (Next.js)
# ============================================================
NEXT_PUBLIC_API_URL=http://portal_cerrado:8000
API_URL=http://portal_cerrado:8000
NEXT_PUBLIC_SITE_URL=https://www.portalcerrado.com.br
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_ADSENSE_ENABLED=false

# ============================================================
# ADSENSE (depois de aprovado) — server side também
# ============================================================
ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx
ADSENSE_ENABLED=false

# ============================================================
# AMBIENTE
# ============================================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Social Media (Twitter/X)
TWITTER_API_KEY=""
TWITTER_API_SECRET=""
TWITTER_ACCESS_TOKEN=""
TWITTER_ACCESS_SECRET=""
