# ============================================================
# Variáveis de Ambiente — Atualiza Brasil
# ============================================================
# Copie este arquivo para .env e preencha os valores
# ============================================================

# ============================================================
# OPENROUTER (LLM FREE)
# ============================================================
# 1. Crie conta em https://openrouter.ai
# 2. Dashboard → Keys → Create Key
# 3. Cole aqui:
OPENROUTER_API_KEY=

# Modelo FREE usado (não precisa pagar!)
# Opções disponíveis:
# - qwen/qwen3-235b-a22b:free (general)
# - meta-llama/llama-3.3-70b-instruct:free (fast)
# - deepseek/deepseek-r1:free (reasoning)
# - mistralai/mistral-small-3.1-24b-instruct:free (creative)
LLM_MODEL=qwen/qwen3-235b-a22b:free

# ============================================================
# DATABASE (PostgreSQL via Docker)
# ============================================================
DATABASE_URL=postgresql://portal_user:portal_pass@postgres:5432/atualiza_brasil
POSTGRES_USER=portal_user
POSTGRES_PASSWORD=portal_pass
POSTGRES_DB=atualiza_brasil

# ============================================================
# REDIS
# ============================================================
REDIS_URL=redis://redis:6379/0

# ============================================================
# CELERY
# ============================================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
# Quando Celery Beat está ativo (docker-compose), desativa o scheduler local duplicado
CELERY_SCHEDULER=0

# ============================================================
# AGENDADOR LOCAL (sem Redis/Celery)
# Roda o pipeline (scan->classify->rewrite->publish->export) no
# próprio processo da API a cada intervalo. Desative (0) quando o
# Celery beat estiver gerenciando o agendamento.
# ============================================================
ENABLE_LOCAL_SCHEDULER=1
LOCAL_SCHEDULER_INTERVAL=1800
# Em produção com docker-compose, atualiza_brasil tem CELERY_SCHEDULER=1 e o scheduler local auto-desativa

# ============================================================
# SITE
# ============================================================
SITE_URL=https://atualizabrasil.news
SITE_NAME=Atualiza Brasil
DEFAULT_LOCALE=pt-BR
TIMEZONE=America/Sao_Paulo

# ============================================================
# SCRAPING
# ============================================================
USER_AGENT=AtualizaBrasil/1.0 (News Aggregator; +https://atualizabrasil.news)
RESPECT_ROBOTS_TXT=true
ROBOTS_TXT_CACHE_HOURS=24
RATE_LIMIT_DEFAULT=10

# ============================================================
# SEGURANÇA / CORS / PUBLISH
# ============================================================
# Chave para POST /api/publish (header X-API-Key). Gere com: openssl rand -hex 32
PUBLISH_API_KEY=coloque_uma_chave_longa_aqui
# Se não setado, em production o /api/publish retorna 503 (fail-closed)
# Em dev, sem chave, o publish é permitido com warning

# CORS: lista explícita (sem wildcard + credentials). Separe por vírgula.
CORS_ALLOWED_ORIGINS=https://atualizabrasil.news,http://localhost:3000,http://100.95.111.24:3000

# Lei 9.610/98 Art. 46/47: similaridade máxima permitida entre reescrita e original (0.35 = 35%)
SIMILARITY_THRESHOLD=0.35

# Deduplicação persistida via Redis (TTL em segundos, default 7 dias)
DEDUP_TTL_SECONDS=604800

# ============================================================
# EMAIL (opcional)
# ============================================================
ADMIN_EMAIL=admin@atualizabrasil.news
PRIVACY_EMAIL=privacidade@atualizabrasil.news

# ============================================================
# MONITORING (opcional)
# ============================================================
SENTRY_DSN=
GRAFANA_API_KEY=

# ============================================================
# GROQ (LLM 100% GRÁTIS - ATIVO)
# ============================================================
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=qwen/qwen3-32b

# ============================================================
# FRONTEND (Next.js)
# ============================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_ADSENSE_ENABLED=false

# ============================================================
# ADSENSE (depois de aprovado) — server side também
# ============================================================
ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx
ADSENSE_ENABLED=false

# ============================================================
# AMBIENTE
# ============================================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
